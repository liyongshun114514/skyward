service hal_olck_ca_oplus /odm/bin/hw/vendor.oplus.hardware.olck_ca-service
    class hal
    user system
    group system radio
    interface aidl vendor.oplus.hardware.olck_ca.IOlckCa/default
    oom_score_adjust -1000
    task_profiles ServiceCapacityHigh
