service oplus_gaia /system/system_ext/bin/oplus_gaia
    class main
    user root
    group system root log ext_data_rw media_rw readproc cache radio bluetooth net_bt wifi everybody audio sdcard_rw misc
    oom_score_adjust -800
    socket postmand stream 0666 system system

on post-fs-data
    mkdir /data/log 0770 system system
    mkdir /data/log/gaia 0770 system system
    mkdir /data/log/ap_log 0770 system system
    mkdir /data/persist_log 0755 system system
    mkdir /data/persist_log/olc 0775 system system
    mkdir /data/persist_log/olc/com.oplus.crashbox 0770 system system
    mkdir /data/persist_log/gaia 0770 system system
    mkdir /data/persist_log/gaia/config 0770 system system
    mkdir /data/persist_log/gaia/rus/ 0770 system system
    mkdir /data/persist_log/gaia/rus/config 0770 system system
    mkdir /data/persist_log/postman 0770 system system
    setprop ro.sys.gaia.versioncode 5
    # Create directory for ostatsd.
    mkdir /data/misc/ostats 0777 root system
    mkdir /data/misc/ostats/packet_files 0777 root system
    mkdir /data/misc/ostats/dcs_config 0777 root system
    mkdir /data/misc/ostats/database 0770 root system
    mkdir /data/misc/ostats/database/thermal_analysis 0770 root system
