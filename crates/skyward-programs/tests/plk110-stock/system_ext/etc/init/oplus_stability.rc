on property:sys.oplus.binder.query_pid=*
    start binder_proc_state_capture

service binder_proc_state_capture /system/system_ext/bin/oplus_stability.sh "binder_proc_state_capture"
    class core
    user root
    group system root shell
    seclabel u:r:dumpstate:s0
    disabled
    oneshot

on post-fs-data
    start stability_proc_func

service stability_proc_func /system/system_ext/bin/oplus_stability.sh "stability_proc_func"
    class core
    user root
    group root
    disabled
    oneshot

on property:ro.secure=0 && property:oplus.autotest.monkeyRunning=true && property:oplus.autotest.camera.debug.forcelog=true
    start watchdog_time_setter

service watchdog_time_setter /system/system_ext/bin/oplus_stability.sh "watchdog_time_setter"
    class core
    user root
    group root
    disabled
    oneshot
